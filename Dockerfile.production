FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/cornerlab/.local/bin:${PATH}"

WORKDIR /srv/cornerlab

RUN addgroup --system --gid 10001 cornerlab \
    && adduser --system --uid 10001 --ingroup cornerlab --home /home/cornerlab cornerlab

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY scripts ./scripts
COPY health_check.py recommended_live_configuration.json ./

RUN chown -R cornerlab:cornerlab /srv/cornerlab

USER cornerlab

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3).read()" || exit 1

CMD ["python3", "-m", "streamlit", "run", "src/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]