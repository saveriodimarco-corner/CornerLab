# CornerLab production environment template
# Copy this file to .env on the Linux VPS and fill in real secrets.
# Do not commit .env to Git.

CORNERLAB_APP_PASSWORD=change-me
THE_ODDS_API_KEY=replace-me
API_FOOTBALL_KEY=replace-me

# Optional additional credentials already used by the project should be added here.
# Example:
# BETFAIR_APP_KEY=replace-me
# BETFAIR_APP_SECRET=replace-me
# PUSHOVER_TOKEN=replace-me
# PUSHOVER_USER=replace-me
