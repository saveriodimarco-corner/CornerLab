[Unit]
Description=CornerLab Premier League shadow collection
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=cornerlab
Group=cornerlab
WorkingDirectory=/srv/cornerlab
EnvironmentFile=/etc/cornerlab/automation.env
Environment=DOCKER_CONFIG=/etc/cornerlab/docker
ExecStart=/usr/bin/docker compose -f /srv/cornerlab/docker-compose.production.yml run --rm --no-deps cornerlab python3 scripts/run_premier_league_shadow.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/cornerlab/data /srv/cornerlab/reports
