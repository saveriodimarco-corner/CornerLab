[Unit]
Description=CornerLab Telegram update worker
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=cornerlab
Group=cornerlab
WorkingDirectory=/srv/cornerlab
EnvironmentFile=/etc/cornerlab/automation.env
Environment=DOCKER_CONFIG=/etc/cornerlab/docker
ExecStartPre=-/usr/bin/docker rm -f cornerlab-telegram-worker
ExecStart=/usr/bin/docker compose -f /srv/cornerlab/docker-compose.production.yml -f /srv/cornerlab/docker-compose.telegram.yml run --rm --name cornerlab-telegram-worker --no-deps cornerlab python3 scripts/run_telegram_bot.py
ExecStop=-/usr/bin/docker rm -f cornerlab-telegram-worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/cornerlab/data /srv/cornerlab/reports

[Install]
WantedBy=multi-user.target
